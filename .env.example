# Copy this file to .env and fill in values locally.
# Never commit real credentials.

APP_ENV=development
LOG_LEVEL=INFO

# SQLite by default. For PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/price_analyzer
DATABASE_URL=sqlite:///data/price_analyzer.db

# mock = synthetic demo data (default, always works)
# live = attempt permitted public access only; often blocked by marketplaces
DATA_SOURCE=mock

REQUEST_TIMEOUT_SECONDS=10
REQUEST_DELAY_SECONDS=2.0
USER_AGENT=ProductPriceAnalyzer/1.0 (portfolio project; educational use)

# Official partner APIs only. Leave empty unless you have your own keys.
# These are not used to bypass marketplace protections.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.in
AMAZON_PAAPI_REGION=eu-west-1

FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
